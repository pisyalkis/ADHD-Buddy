# Токен бота от @BotFather (обязательно)
BOT_TOKEN=YOUR_BOT_TOKEN

# Твой Telegram ID — для утренних/дневных/вечерних уведомлений (узнать у @userinfobot)
NOTIFY_USER_ID=0

# Ключ Anthropic API — без него бот работает, но без AI-коуча и AI-анализа (необязательно)
ANTHROPIC_KEY=

# Бэкап БД на почту через Gmail SMTP — необязательно, дублирует уже существующий
# бэкап в Telegram (NOTIFY_USER_ID). Без SMTP_USER/SMTP_APP_PASSWORD email-бэкап
# просто не пытается отправиться, остальной бэкап работает как раньше.
# SMTP_USER — твой Gmail-адрес (отправитель и логин для SMTP).
SMTP_USER=
# SMTP_APP_PASSWORD — ИМЕННО app password Gmail (16 символов вида "xxxx xxxx xxxx xxxx"),
# НЕ обычный пароль от аккаунта. Требует включённой двухфакторной аутентификации:
# myaccount.google.com/apppasswords -> создать пароль приложения -> вставить сюда.
SMTP_APP_PASSWORD=
# Куда слать бэкап — необязательно, по умолчанию совпадает с SMTP_USER (шлёшь сам себе)
BACKUP_EMAIL_TO=
